APP_ENV=local
APP_NAME=Agent
APP_VERSION=0.1.0
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://momcozy_agent_runtime:momcozy_agent_runtime@postgres:5432/momcozy_agent_runtime
DATABASE_TIMEOUT_SECONDS=3

REDIS_URL=redis://redis:6379/0
REDIS_TIMEOUT_SECONDS=1
WORKER_HEARTBEATS_REQUIRED=true
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_HEARTBEAT_TTL_SECONDS=30
API_MAX_REQUEST_BODY_BYTES=65536
AGENT_RUN_OWNER_RATE_LIMIT=20
AGENT_RUN_OWNER_RATE_WINDOW_SECONDS=60
AGENT_RUN_OWNER_ACTIVE_LIMIT=3
# Leak-recovery backstop; terminal transitions release slots immediately.
AGENT_RUN_OWNER_ACTIVE_TTL_SECONDS=2100

PRODUCT_BACKEND_BASE_URL=http://host.docker.internal:8000
# Must match Product Backend AGENT_RUNTIME_SERVICE_API_KEY.
PRODUCT_BACKEND_SERVICE_KEY=local-agent-runtime-service-key-with-at-least-32-bytes
PRODUCT_BACKEND_TIMEOUT_SECONDS=5

RUNTIME_OUTPUT_STORE_BUCKET=agent-runtime
RUNTIME_OUTPUT_STORE_PREFIX=tool-outputs
RUNTIME_OUTPUT_STORE_ENDPOINT_URL=http://minio:9000
RUNTIME_OUTPUT_STORE_REGION=us-east-1
RUNTIME_OUTPUT_STORE_ACCESS_KEY_ID=minioadmin
RUNTIME_OUTPUT_STORE_SECRET_ACCESS_KEY=minioadmin
AGENT_TOOL_OUTPUT_MAX_INLINE_BYTES=32768

# Dedicated inbound credential for /v1/agent/admin/* only.
RUNTIME_ADMIN_SERVICE_KEY=local-runtime-admin-service-key-with-at-least-32-bytes

AUTH_JWKS_URL=http://host.docker.internal:8000/.well-known/jwks.json
AUTH_JWT_ISSUER=momcozy-local
AUTH_JWT_AUDIENCE=momcozy-agent-runtime
AUTH_JWKS_TIMEOUT_SECONDS=2
AUTH_JWKS_CACHE_TTL_SECONDS=900
AUTH_JWKS_KID_MISS_COOLDOWN_SECONDS=30

# Required only by the worker service.
AGENT_MODEL_PROVIDER=openai_responses
OPENAI_API_KEY=replace-with-openai-api-key
# Set both values only for a gateway that implements the OpenAI Responses API.
# OPENAI_BASE_URL=https://responses-gateway.example.com/v1
OPENAI_RESPONSES_COMPATIBLE_BASE_URL=false
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
OPENAI_TEXT_VERBOSITY=low
OPENAI_RESPONSES_STORE=false
AGENT_MAX_TURNS=10
AGENT_MODEL_TIMEOUT_SECONDS=60
AGENT_WORKER_BATCH_SIZE=8
AGENT_WORKER_CONCURRENCY=4
AGENT_WORKER_POLL_INTERVAL_SECONDS=0.5
AGENT_WORKER_DB_LEASE_DURATION_SECONDS=180
AGENT_WORKER_DB_LEASE_RENEW_INTERVAL_SECONDS=30
AGENT_WORKER_LOCK_TTL_SECONDS=120
AGENT_CONTEXT_COMPACTION_THRESHOLD_TOKENS=100000
# Reserved for the model response on every complete model request.
AGENT_CONTEXT_RESPONSE_RESERVE_TOKENS=8000
AGENT_CONTEXT_SUMMARY_MAX_TOKENS=2000
AGENT_CONTEXT_COMPACTION_MAX_ATTEMPTS=3
AGENT_CONTEXT_COMPACTION_BATCH_SIZE=2
AGENT_CONTEXT_COMPACTION_CONCURRENCY=1
# Independent low-frequency sweep; this is not tied to the 0.5s run poll.
AGENT_ACTION_EXPIRY_SCAN_INTERVAL_SECONDS=30
AGENT_ACTION_EXPIRY_BATCH_SIZE=64
