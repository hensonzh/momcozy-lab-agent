# B US-East single-host template. Copy to a distinct mode-0600 private env file.
APP_ENV=staging
MOMCOZY_B_ENV_MARKER=us-east-uat
APP_NAME="Agent Runtime"
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Deployment topology (non-secret). Product Backend must use the same values.
MOMCOZY_BACKEND_COMPOSE_PROJECT=momcozy-lab-backend-us-east-uat
MOMCOZY_AGENT_COMPOSE_PROJECT=momcozy-lab-agent-us-east-uat
MOMCOZY_NETWORK_NAME=momcozy-lab-us-east-uat
MOMCOZY_BACKEND_API_BIND=127.0.0.1:8001
MOMCOZY_AGENT_API_BIND=127.0.0.1:8002
# B public HTTPS requires a publicly trusted certificate; do not reuse A's internal CA.
MOMCOZY_AGENT_TRUST_BUNDLE_FILE=/etc/ssl/certs/ca-certificates.crt
MOMCOZY_BACKEND_PUBLIC_URL=https://backend-us-dev.lute-momcozylab.luteos.cloud
MOMCOZY_AGENT_PUBLIC_URL=https://agent-us-dev.lute-momcozylab.luteos.cloud
MOMCOZY_POSTGRES_ADMIN_USER=momcozy_us_east_uat_admin
MOMCOZY_AGENT_POSTGRES_DB=momcozy_lab_agent_uat
MOMCOZY_AGENT_POSTGRES_USER=momcozy_lab_agent_uat
MOMCOZY_AGENT_MINIO_BUCKET=momcozy-agent-us-east-uat
# Dedicated Product-to-Runtime report credential; not a user/admin key.

# These values must match the service-scoped credentials in the private Product Backend US-East UAT env.
# Product Backend Compose owns the shared services and creates the Agent Runtime
# database and MinIO bucket.
MOMCOZY_AGENT_POSTGRES_PASSWORD=REPLACE_WITH_US_EAST_UAT_MOMCOZY_AGENT_POSTGRES_PASSWORD
MOMCOZY_AGENT_REDIS_PASSWORD=REPLACE_WITH_US_EAST_UAT_MOMCOZY_AGENT_REDIS_PASSWORD
MOMCOZY_AGENT_MINIO_ACCESS_KEY=REPLACE_WITH_US_EAST_UAT_MOMCOZY_AGENT_MINIO_ACCESS_KEY
MOMCOZY_AGENT_MINIO_SECRET_KEY=REPLACE_WITH_US_EAST_UAT_MOMCOZY_AGENT_MINIO_SECRET_KEY

# PostgreSQL service is shared; Agent Runtime owns this separate database and role.
DATABASE_URL=postgresql+asyncpg://momcozy_lab_agent_uat:${MOMCOZY_AGENT_POSTGRES_PASSWORD}@postgres:5432/momcozy_lab_agent_uat
DATABASE_TIMEOUT_SECONDS=3

# Redis service is shared; ACL restricts Agent Runtime to logical DB 0 and agent-runtime:* keys.
REDIS_URL=redis://agent-runtime:${MOMCOZY_AGENT_REDIS_PASSWORD}@redis:6379/0
REDIS_TIMEOUT_SECONDS=1
WORKER_HEARTBEATS_REQUIRED=true
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_HEARTBEAT_TTL_SECONDS=30
API_MAX_REQUEST_BODY_BYTES=65536
AGENT_RUN_OWNER_RATE_LIMIT=20
AGENT_RUN_OWNER_RATE_WINDOW_SECONDS=60
AGENT_RUN_OWNER_ACTIVE_LIMIT=3
AGENT_RUN_OWNER_ACTIVE_TTL_SECONDS=2100

PRODUCT_BACKEND_BASE_URL=https://backend-us-dev.lute-momcozylab.luteos.cloud
PRODUCT_BACKEND_SERVICE_KEY=REPLACE_WITH_US_EAST_UAT_PRODUCT_BACKEND_SERVICE_KEY
PRODUCT_BACKEND_TIMEOUT_SECONDS=5

# MinIO service is shared; this user is policy-restricted to the Agent Runtime bucket.
RUNTIME_OUTPUT_STORE_BUCKET=momcozy-agent-us-east-uat
RUNTIME_OUTPUT_STORE_PREFIX=tool-outputs
RUNTIME_OUTPUT_STORE_ENDPOINT_URL=http://minio:9000
RUNTIME_OUTPUT_STORE_REGION=us-east-1
RUNTIME_OUTPUT_STORE_ACCESS_KEY_ID=${MOMCOZY_AGENT_MINIO_ACCESS_KEY}
RUNTIME_OUTPUT_STORE_SECRET_ACCESS_KEY=${MOMCOZY_AGENT_MINIO_SECRET_KEY}
AGENT_TOOL_OUTPUT_MAX_INLINE_BYTES=32768

RUNTIME_ADMIN_SERVICE_KEY=REPLACE_WITH_US_EAST_UAT_RUNTIME_ADMIN_SERVICE_KEY

AUTH_JWKS_URL=https://backend-us-dev.lute-momcozylab.luteos.cloud/.well-known/jwks.json
AUTH_JWT_ISSUER=momcozy-product-us-east-uat
AUTH_JWT_AUDIENCE=momcozy-agent-runtime
AUTH_JWKS_TIMEOUT_SECONDS=2
AUTH_JWKS_CACHE_TTL_SECONDS=900
AUTH_JWKS_KID_MISS_COOLDOWN_SECONDS=30

# Select exactly one model provider. The Azure alternative below is explicit
# because deployment identity must never be inferred from a mutable alias.
AGENT_MODEL_PROVIDER=openai_responses
OPENAI_API_KEY=REPLACE_WITH_US_EAST_UAT_OPENAI_API_KEY
OPENAI_RESPONSES_COMPATIBLE_BASE_URL=false
OPENAI_MODEL=gpt-5.6-terra
AGENT_MODEL_REASONING_EFFORT=low
AGENT_MODEL_TEXT_VERBOSITY=low
AGENT_MODEL_STORE=false
# AGENT_MODEL_PROVIDER=azure_openai_responses
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/openai/v1
# AZURE_OPENAI_AUTH_MODE=entra
# AZURE_OPENAI_API_KEY=REPLACE_WITH_US_EAST_UAT_OPENAI_API_KEY
# AZURE_OPENAI_DEPLOYMENT=<deployment-name>
# AZURE_OPENAI_MODEL_FAMILY=gpt-5.6-terra
# AZURE_OPENAI_MODEL_VERSION=<deployed-model-version>
# AZURE_OPENAI_REGION=<azure-region>
# AZURE_OPENAI_DEPLOYMENT_TYPE=standard
# AZURE_OPENAI_TOKEN_SCOPE=https://ai.azure.com/.default
# AZURE_OPENAI_TOKEN_ESTIMATOR_SAFETY_FACTOR=1.25

AGENT_MAX_TURNS=10
AGENT_MODEL_TIMEOUT_SECONDS=60
AGENT_MODEL_MAX_OUTPUT_TOKENS=8000
AGENT_WORKER_BATCH_SIZE=10
AGENT_WORKER_CONCURRENCY=10
AGENT_WORKER_POLL_INTERVAL_SECONDS=0.5
AGENT_WORKER_DB_LEASE_DURATION_SECONDS=180
AGENT_WORKER_DB_LEASE_RENEW_INTERVAL_SECONDS=30
AGENT_WORKER_LOCK_TTL_SECONDS=120
AGENT_CONTEXT_COMPACTION_THRESHOLD_TOKENS=200000
AGENT_CONTEXT_RESPONSE_RESERVE_TOKENS=8000
AGENT_CONTEXT_SUMMARY_MAX_TOKENS=2000
AGENT_CONTEXT_COMPACTION_MAX_ATTEMPTS=3
AGENT_CONTEXT_COMPACTION_BATCH_SIZE=2
AGENT_CONTEXT_COMPACTION_CONCURRENCY=1
AGENT_ACTION_EXPIRY_SCAN_INTERVAL_SECONDS=30
AGENT_ACTION_EXPIRY_BATCH_SIZE=64

# Provisional UAT limits for Compose rendering only, NOT a proven 10-run sizing.
# Review and adjust after measuring 10 concurrent runs on the B host.
MOMCOZY_AGENT_WORKER_CPUS=4.0
MOMCOZY_AGENT_WORKER_MEM_LIMIT=6g
