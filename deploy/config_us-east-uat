# US-East UAT (B) non-secret defaults for the planned single-host Compose stack.
# This file is not a complete env_file and does not start the stack by itself.
# Agent joins the B Backend-owned network and shares its PostgreSQL, Redis and
# MinIO containers; it never starts a second stateful stack.
# Its independent database is momcozy_lab_agent_uat; Product uses
# momcozy_lab_backend_uat in the same self-hosted PostgreSQL instance.
# Both services use B Redis DB 0 with distinct key prefixes and ACL users:
# Product rate-limit:* and product:*; Agent agent-runtime:* and
# momcozy-agent-runtime:*.
# Both use B MinIO, with separate private buckets and scoped credentials.
# Inject complete DATABASE_URL, REDIS_URL, bucket and credentials only via
# the private B runtime env; do not reuse former managed-service credentials.
APP_ENV=staging
LOG_LEVEL=INFO
WORKER_HEARTBEATS_REQUIRED=true
RUNTIME_OUTPUT_STORE_ENDPOINT_URL=http://minio:9000
RUNTIME_OUTPUT_STORE_REGION=us-east-1
# Per worker process, not a promise of 10-run throughput; measure CPU/RSS,
# provider limits and latency on the US-East host before enabling release.
AGENT_WORKER_BATCH_SIZE=10
AGENT_WORKER_CONCURRENCY=10
